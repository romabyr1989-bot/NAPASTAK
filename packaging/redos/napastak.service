[Unit]
Description=NAPASTAK gateway (MDM/CDI)
Documentation=https://github.com/romabyr1989-bot/NAPASTAK
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=napastak
Group=napastak
# UI и плагины ищутся относительно рабочего каталога (ui/index.html, lib/*.so)
WorkingDirectory=/opt/napastak
# Автономность: рантайм-библиотеки берутся из вложенной папки lib/deps (офлайн)
Environment=LD_LIBRARY_PATH=/opt/napastak/lib/deps
ExecStart=/opt/napastak/bin/napastak_gateway -c /opt/napastak/config.json
Restart=on-failure
RestartSec=3
# 78 (EX_CONFIG) — гейтвей отказался стартовать по причине, которая сама не
# исправится: база от более новой версии NAPASTAK. Перезапуск по кругу такую
# ошибку не лечит, а только забивает журнал, скрывая первую внятную строку.
RestartPreventExitStatus=78
LimitNOFILE=65536

# Защита (данные пишутся только в /var/lib/napastak)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/napastak

[Install]
WantedBy=multi-user.target
